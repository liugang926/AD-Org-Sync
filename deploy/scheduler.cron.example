# Installed for the production runner account by scripts/install-scheduler.sh.
# The command only queues work; Configuration.schedule_enabled controls whether it runs.
* * * * * /usr/bin/docker exec ad_org_sync-web-1 python -m sync_app.cli enqueue_sync --due 2>&1 | /usr/bin/logger -t ad-org-sync-scheduler # AD_ORG_SYNC_SCHEDULER
