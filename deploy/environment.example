# Protected production file: chmod 0600. Never commit real values.
AD_ORG_SYNC_PUBLIC_BASE_URL=https://it-service.tianjizn.com:9443
AD_ORG_SYNC_HTTP_BIND=127.0.0.1
AD_ORG_SYNC_HTTP_PORT=80
AD_ORG_SYNC_ADMIN_USERNAME=admin
AD_ORG_SYNC_ADMIN_PASSWORD_FILE=/opt/ad-org-sync/shared/admin_password.txt
# Container path inside the existing /data volume. Default stays /data.
# A separate production database can use /data/production after explicit setup.
# AD_ORG_SYNC_DATA_DIR=/data/production
DINGTALK_CORP_ID=
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
# Optional password-reset robot: store its complete webhook in a protected file.
# Host files must be mode 0400 or 0600; never put webhook tokens in this environment.
# Unset disables notifications; a configured but invalid file records notice failure.
# DINGTALK_PASSWORD_ROBOT_WEBHOOK_HOST_FILE=/opt/ad-org-sync/shared/password_robot_webhook.txt
# Optional robot signing secret, in its own protected file. Unset means no signing.
# Once configured, a missing, empty or unreadable signing file is an error.
# DINGTALK_PASSWORD_ROBOT_SIGN_SECRET_HOST_FILE=/opt/ad-org-sync/shared/password_robot_sign_secret.txt
# Optional pilot: comma-separated DingTalk userId values (not job numbers).
# Unset means all uniquely matched employees can use SSPR once enabled.
# SSPR_ALLOWED_DINGTALK_USER_IDS=user-id-1,user-id-2
LDAP_HOST=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_PASSWORD=
LDAP_VERIFY_CERT=false
# Optional: enable verification and supply a CA when desired.
# LDAP_VERIFY_CERT=true
# LDAP_CA_HOST_FILE=/opt/ad-org-sync/shared/ad-ca.pem
